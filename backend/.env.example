# Database
DATABASE_URL=postgresql+asyncpg://kapitmas:password@localhost:5432/kapitmas_iot

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_QOS=1

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase (path ke file service account JSON)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Devices
DEVICE_OFFLINE_TIMEOUT=720
DEVICE_EVENT_RETENTION_DAYS=30

# Timbangan
TIMBANGAN_STATUS_TIMEOUT=360
TIMBANGAN_BACKUP_TIME_HOUR=23
TIMBANGAN_BACKUP_TIME_MINUTE=0
TIMBANGAN_LOG_RETENTION_DAYS=14
TIMBANGAN_BACKUP_RETENTION_DAYS=30
TIMBANGAN_DATA_DIR=data/timbangan
TIMBANGAN_BACKUP_DIR=data/timbangan/backups
TIMBANGAN_FIRMWARE_DIR=data/firmware/timbangan
TIMBANGAN_OTA_BASE_URL=http://localhost:8000
TIMBANGAN_OTA_DOWNLOAD_SECRET=ganti-dengan-string-rahasia-yang-panjang
TIMBANGAN_DEVICE_MENU_PASSWORD=admin123