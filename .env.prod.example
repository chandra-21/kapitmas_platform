# ============================================================
# KAIIS Production Environment — salin ke .env.prod dan isi
# ============================================================

# --- PostgreSQL (dibaca langsung oleh image postgres) ---
POSTGRES_USER=kapitmas
POSTGRES_PASSWORD=GANTI_PASSWORD_DB_KUAT
POSTGRES_DB=kapitmas_iot

# --- Admin (hardcoded login, bypass Firebase) ---
ADMIN_USERNAME=GANTI_EMAIL_ADMIN
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KUAT

# --- JWT (generate dengan: openssl rand -hex 32) ---
JWT_SECRET=GANTI_JWT_SECRET_PANJANG_RAHASIA

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://kapitmas:GANTI_PASSWORD_DB_KUAT@postgres:5432/kapitmas_iot

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=kapitmas
MQTT_PASSWORD=GANTI_PASSWORD_MQTT_KUAT
MQTT_KEEPALIVE=60
MQTT_QOS=1

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Ganti dengan IP atau domain Orange Pi kamu
CORS_ORIGINS=http://IP_ORANGEPI

FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json

DEVICE_OFFLINE_TIMEOUT=720
DEVICE_EVENT_RETENTION_DAYS=30

TIMBANGAN_STATUS_TIMEOUT=360
TIMBANGAN_BACKUP_TIME_HOUR=23
TIMBANGAN_BACKUP_TIME_MINUTE=0
TIMBANGAN_LOG_RETENTION_DAYS=14
TIMBANGAN_BACKUP_RETENTION_DAYS=30
TIMBANGAN_DATA_DIR=/app/data/timbangan
TIMBANGAN_BACKUP_DIR=/app/data/timbangan/backups
TIMBANGAN_FIRMWARE_DIR=/app/data/firmware/timbangan

# Ganti dengan IP atau domain Orange Pi kamu
TIMBANGAN_OTA_BASE_URL=http://IP_ORANGEPI

# Generate dengan: openssl rand -hex 32
TIMBANGAN_OTA_DOWNLOAD_SECRET=GANTI_STRING_PANJANG_RAHASIA

TIMBANGAN_DEVICE_MENU_PASSWORD=GANTI_PASSWORD_MENU
